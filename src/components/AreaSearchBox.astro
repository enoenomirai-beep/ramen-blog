---
/**
 * エリア別ページ上部の近接駅・沿線対応インクリメンタルサーチ。
 *
 * 記事ごとに「同じグループ（徒歩圏内）に属する駅名一覧」を location-map.ts の
 * getGroupStations() で事前計算して埋め込み、クライアント側ではその中のどれかに
 * 入力値が部分一致すれば表示する（Vanilla JS）。
 * グループの駅一覧はどちらの記事も同じなので、双方向にヒットする
 * （「秋葉原」で検索しても「末広町」で検索しても、お互いの記事が出る）。
 * 同様に、その駅を通る鉄道路線名（getLines()）も検索対象にしているので、
 * 「山手線」「つくばエクスプレス」のような沿線名でもヒットする。
 */
import { getGroupStations, getLines, getLocationInfo } from '../lib/location-map';
import type { Post } from '../lib/posts';
import PostListItem from './PostListItem.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

<div data-area-search>
	<label for="area-search-input" class="sr-only">エリアで検索（近接駅もまとめてヒットします）</label>
	<div class="relative">
		<svg
			class="pointer-events-none absolute top-1/2 left-3.5 size-4 -translate-y-1/2 text-ink-faint"
			viewBox="0 0 20 20"
			fill="currentColor"
			aria-hidden="true"
		>
			<path
				fill-rule="evenodd"
				d="M8.5 3a5.5 5.5 0 1 0 3.38 9.84l3.64 3.65a.75.75 0 1 0 1.06-1.06l-3.65-3.64A5.5 5.5 0 0 0 8.5 3ZM4.5 8.5a4 4 0 1 1 8 0 4 4 0 0 1-8 0Z"
				clip-rule="evenodd"></path>
		</svg>
		<input
			id="area-search-input"
			type="search"
			inputmode="search"
			autocomplete="off"
			placeholder="駅名・エリア名・沿線名で検索（例: 秋葉原、山手線）"
			class="w-full rounded-full border border-line-strong bg-surface-raised py-2.5 pr-4 pl-10 text-sm font-medium text-ink placeholder:text-ink-faint hover:border-brand-400 focus:border-brand-500"
			data-area-search-input
		/>
	</div>

	<div data-area-search-results hidden class="mt-4">
		<p class="mb-3 text-sm text-ink-muted">
			<span data-area-search-count class="font-bold text-ink">0</span> 件ヒット
		</p>
		<ol class="flex flex-col gap-4">
			{
				posts.map((post) => {
					const info = getLocationInfo(post.data.location);
					// 同じグループ（徒歩圏内）の駅名一覧。駅名に "|" は使わない前提の区切り文字
					const groupStations = getGroupStations(post.data.location).join('|');
					// その駅を通る鉄道路線名（「山手線」などの沿線名でも検索できるようにする）
					const lines = getLines(post.data.location).join('|');
					return (
						<li
							data-area-search-item
							data-location={post.data.location}
							data-group-stations={groupStations}
							data-lines={lines}
							data-prefecture={info.prefecture}
						>
							<PostListItem post={post} />
						</li>
					);
				})
			}
		</ol>
		<p
			data-area-search-empty
			hidden
			class="rounded-xl border border-dashed border-line-strong bg-surface-raised px-6 py-12 text-center text-sm text-ink-muted"
		>
			該当する記事はありません。
		</p>
	</div>
</div>

<script>
	const root = document.querySelector<HTMLElement>('[data-area-search]');
	if (root) {
		const input = root.querySelector<HTMLInputElement>('[data-area-search-input]')!;
		const resultsEl = root.querySelector<HTMLElement>('[data-area-search-results]')!;
		const countEl = root.querySelector<HTMLElement>('[data-area-search-count]');
		const emptyEl = root.querySelector<HTMLElement>('[data-area-search-empty]');
		const items = Array.from(root.querySelectorAll<HTMLElement>('[data-area-search-item]'));

		function render() {
			const query = input.value.trim().toLowerCase();
			resultsEl.hidden = query === '';
			if (query === '') return;

			let visible = 0;
			for (const item of items) {
				const d = item.dataset;
				// 同じグループの駅名・沿線名のどれか、または都道府県に部分一致すればヒット（双方向）
				const stations = (d.groupStations ?? '').split('|');
				const lines = (d.lines ?? '').split('|');
				const match =
					stations.some((station) => station.toLowerCase().includes(query)) ||
					lines.some((line) => line.toLowerCase().includes(query)) ||
					(d.prefecture ?? '').toLowerCase().includes(query);
				item.hidden = !match;
				if (match) visible++;
			}
			if (countEl) countEl.textContent = String(visible);
			if (emptyEl) emptyEl.hidden = visible > 0;
		}

		input.addEventListener('input', render);
		render();
	}
</script>
