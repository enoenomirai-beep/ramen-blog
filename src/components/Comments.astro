---
/**
 * Giscus（GitHub Discussions を使った無料のコメント欄）。
 *
 * data-repo-id / data-category-id は https://giscus.app で発行される値に
 * 置き換える必要がある。リポジトリで Discussions を有効化し、giscus app を
 * インストールしてから発行される（現状はプレースホルダーのまま）。
 * data-repo はこのリポジトリ名（enoenomirai-beep/ramen-blog）を設定済み。
 *
 * サイトのダークモード切り替えに giscus 側のテーマも同期させる（Vanilla JS）。
 */
---

<section class="mt-8 border-t border-line pt-6" aria-labelledby="comments-heading">
	<h2 id="comments-heading" class="mb-4 text-lg font-extrabold text-ink">コメント</h2>
	<div data-giscus-container></div>
</section>

<script>
	const container = document.querySelector<HTMLElement>('[data-giscus-container]');
	if (container) {
		function currentTheme(): 'light' | 'dark' {
			return document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
		}

		const script = document.createElement('script');
		script.src = 'https://giscus.app/client.js';
		script.async = true;
		script.crossOrigin = 'anonymous';
		script.setAttribute('data-repo', 'enoenomirai-beep/ramen-blog');
		// TODO: https://giscus.app で Discussions を有効化して発行される実際の ID に置き換える
		script.setAttribute('data-repo-id', 'REPLACE_WITH_GISCUS_REPO_ID');
		script.setAttribute('data-category', 'Comments');
		script.setAttribute('data-category-id', 'REPLACE_WITH_GISCUS_CATEGORY_ID');
		script.setAttribute('data-mapping', 'pathname');
		script.setAttribute('data-strict', '0');
		script.setAttribute('data-reactions-enabled', '1');
		script.setAttribute('data-emit-metadata', '0');
		script.setAttribute('data-input-position', 'bottom');
		script.setAttribute('data-theme', currentTheme());
		script.setAttribute('data-lang', 'ja');
		script.setAttribute('data-loading', 'lazy');
		container.appendChild(script);

		function postThemeToGiscus(theme: 'light' | 'dark') {
			const iframe = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
			iframe?.contentWindow?.postMessage({ giscus: { setConfig: { theme } } }, 'https://giscus.app');
		}

		new MutationObserver(() => postThemeToGiscus(currentTheme())).observe(document.documentElement, {
			attributeFilter: ['data-theme'],
		});
	}
</script>
