---
/**
 * 記事本文の目次。
 *
 * `render(post)` が返す headings のうち h2 / h3 から生成する（h2 を親、直後の h3 を子にネスト）。
 * 見出しが 2 つ未満のときは何も表示しない。<details> で折りたためる。
 */
import type { MarkdownHeading } from 'astro';

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

interface TocItem extends MarkdownHeading {
	children: MarkdownHeading[];
}
const items: TocItem[] = [];
for (const heading of headings) {
	if (heading.depth === 2) items.push({ ...heading, children: [] });
	else if (heading.depth === 3 && items.length > 0) items[items.length - 1].children.push(heading);
}
const count = items.reduce((n, item) => n + 1 + item.children.length, 0);

const linkClass = 'text-ink underline-offset-2 hover:text-brand-fg hover:underline';
---

{
	count >= 2 && (
		<nav aria-label="目次" class="mb-8 overflow-hidden rounded-xl border border-line bg-surface-raised text-sm shadow-sm">
			<details open>
				<summary class="cursor-pointer bg-surface-sunken px-4 py-2 font-bold text-ink select-none marker:text-brand-fg">
					目次
				</summary>
				<ol class="list-decimal space-y-1.5 py-3 pr-4 pl-10 marker:font-bold marker:text-brand-fg">
					{items.map((item) => (
						<li>
							<a href={`#${item.slug}`} class={linkClass}>
								{item.text}
							</a>
							{item.children.length > 0 && (
								<ol class="mt-1 list-disc space-y-1 pl-5 marker:text-accent-500">
									{item.children.map((child) => (
										<li>
											<a href={`#${child.slug}`} class={linkClass}>
												{child.text}
											</a>
										</li>
									))}
								</ol>
							)}
						</li>
					))}
				</ol>
			</details>
		</nav>
	)
}
