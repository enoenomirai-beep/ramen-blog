---
/**
 * 系統別・エリア別など「内訳」を円グラフ（ドーナツ）＋凡例で表示する、出費ダッシュボード用のコンポーネント。
 * CSS の conic-gradient だけで描画する（JS・SVG 不要の軽量な実装）。
 *
 * 色は src/styles/global.css の --chart-series-1〜6（識別用に固定順で用意した6色。ブランドの暖色だけでは
 * 色同士の区別がつきにくいため別枠で用意）を使う。件数の多い順に固定の6色を割り当て、7件目以降は「その他」に
 * まとめる。円グラフは装飾（aria-hidden）とし、系統名・件数・割合は凡例のテキストで必ず読めるようにする
 * （色だけに情報を乗せない）
 */
interface Item {
	label: string;
	count: number;
}
interface Props {
	title: string;
	items: Item[];
}

const { title, items } = Astro.props;

const MAX_SLICES = 6;
const sorted = [...items].sort((a, b) => b.count - a.count);
const visible = sorted.length > MAX_SLICES ? sorted.slice(0, MAX_SLICES - 1) : sorted;
const otherCount =
	sorted.length > MAX_SLICES ? sorted.slice(MAX_SLICES - 1).reduce((sum, item) => sum + item.count, 0) : 0;
const slices: Item[] = otherCount > 0 ? [...visible, { label: 'その他', count: otherCount }] : visible;

const total = slices.reduce((sum, item) => sum + item.count, 0);

const SERIES_DOT_CLASSES = [
	'bg-chart-series-1',
	'bg-chart-series-2',
	'bg-chart-series-3',
	'bg-chart-series-4',
	'bg-chart-series-5',
	'bg-chart-series-6',
];

let cumulativeDeg = 0;
const stops = slices.map((item, i) => {
	const share = total > 0 ? item.count / total : 0;
	const startDeg = cumulativeDeg;
	cumulativeDeg += share * 360;
	return {
		label: item.label,
		count: item.count,
		share,
		startDeg,
		endDeg: cumulativeDeg,
		colorVar: `var(--chart-series-${i + 1})`,
		dotClass: SERIES_DOT_CLASSES[i],
	};
});

const gradient =
	total > 0
		? `conic-gradient(${stops.map((s) => `${s.colorVar} ${s.startDeg}deg ${s.endDeg}deg`).join(', ')})`
		: 'none';
---

<div>
	<h3 class="text-sm font-bold text-ink">{title}</h3>

	{
		total === 0 ? (
			<p class="mt-3 text-xs text-ink-faint">集計できる記事がありません。</p>
		) : (
			<div class="mt-4 flex flex-col items-center gap-4 sm:flex-row">
				<div
					class="relative size-32 shrink-0 rounded-full sm:size-36"
					style={`background: ${gradient};`}
					aria-hidden="true"
				>
					<div class="absolute inset-3 flex flex-col items-center justify-center rounded-full bg-surface-raised">
						<span class="text-lg font-extrabold text-ink">{total}</span>
						<span class="text-[10px] text-ink-faint">件</span>
					</div>
				</div>
				<ul class="flex w-full min-w-0 flex-col gap-1.5">
					{stops.map((s) => (
						<li class="flex items-center justify-between gap-2 text-sm">
							<span class="flex min-w-0 items-center gap-2">
								<span class={`size-2.5 shrink-0 rounded-full ${s.dotClass}`} aria-hidden="true" />
								<span class="truncate font-medium text-ink">{s.label}</span>
							</span>
							<span class="shrink-0 text-xs text-ink-muted tabular-nums">
								{s.count}件・{Math.round(s.share * 100)}%
							</span>
						</li>
					))}
				</ul>
			</div>
		)
	}
</div>
