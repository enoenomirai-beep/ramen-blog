---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import { formatDate, withBase } from '../consts';
import RatingStars from './RatingStars.astro';

interface Props {
	post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, shop_name, style, location, rating, description, image, image_alt } = post.data;
const href = withBase(`/posts/${post.id}/`);
---

<article
	class="group flex h-full flex-col overflow-hidden rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
>
	<a href={href} class="flex h-full flex-col">
		<div class="aspect-3/2 w-full overflow-hidden bg-stone-100 dark:bg-stone-800">
			{
				image ? (
					<Image
						src={image}
						alt={image_alt ?? ''}
						widths={[400, 800, 1200]}
						sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
						loading="lazy"
						class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]"
					/>
				) : (
					<div class="flex h-full w-full items-center justify-center text-5xl" aria-hidden="true">
						🍜
					</div>
				)
			}
		</div>

		<div class="flex flex-1 flex-col p-5">
			<div class="mb-3 flex flex-wrap items-center gap-2">
				<span
					class="inline-flex items-center rounded-full bg-orange-100 dark:bg-orange-950 px-2.5 py-0.5 text-xs font-semibold text-orange-800 dark:text-orange-300"
				>
					{style}
				</span>
				<span class="inline-flex items-center gap-1 text-xs text-stone-500 dark:text-stone-400">
					<svg class="size-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
						<path
							fill-rule="evenodd"
							d="M9.7 17.7a.5.5 0 0 0 .6 0C13.6 15.2 16 12.3 16 8.9A6 6 0 0 0 4 8.9c0 3.4 2.4 6.3 5.7 8.8ZM10 11a2.3 2.3 0 1 0 0-4.6 2.3 2.3 0 0 0 0 4.6Z"
							clip-rule="evenodd"></path>
					</svg>
					{location}
				</span>
			</div>

			<p class="text-sm font-medium text-stone-500 dark:text-stone-400">{shop_name}</p>
			<h2 class="mt-1 text-lg leading-snug font-bold text-stone-900 dark:text-stone-100 group-hover:text-orange-700 dark:group-hover:text-orange-400">
				{title}
			</h2>

			{description && <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-stone-600 dark:text-stone-400">{description}</p>}

			<div class="mt-auto flex items-center justify-between gap-3 pt-4">
				<RatingStars rating={rating} />
				<time datetime={date.toISOString()} class="text-xs text-stone-500 dark:text-stone-400">{formatDate(date)}</time>
			</div>
		</div>
	</a>
</article>
