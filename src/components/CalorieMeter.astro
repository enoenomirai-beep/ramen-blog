---
/**
 * 「免罪符（ギルティ）メーター」。系統（style）に応じた概算カロリー・PFCバランスと、
 * それを消費するための運動換算（スクワット・ランニング）をユーモアを添えて表示する。
 * すべて src/lib/nutrition.ts のハードコードされた目安値（あくまで概算）。
 */
import { getStyleNutrition, runningKmFor, squatHoursFor } from '../lib/nutrition';

interface Props {
	style: string;
}

const { style } = Astro.props;
const nutrition = getStyleNutrition(style);
const pfcTotal = nutrition.protein + nutrition.fat + nutrition.carbs;
const proteinPct = (nutrition.protein / pfcTotal) * 100;
const fatPct = (nutrition.fat / pfcTotal) * 100;
const carbsPct = (nutrition.carbs / pfcTotal) * 100;
const squatHours = squatHoursFor(nutrition.kcal);
const runningKm = runningKmFor(nutrition.kcal);
---

<section
	class="mt-6 overflow-hidden rounded-xl border border-line bg-surface-raised shadow-sm"
	aria-labelledby="calorie-meter-heading"
>
	<h2 id="calorie-meter-heading" class="border-b border-line bg-surface-sunken px-4 py-2 text-sm font-bold text-ink">
		🍜 免罪符メーター（概算・目安）
	</h2>
	<div class="px-4 py-3.5">
		<p class="text-sm text-ink-muted">
			概算カロリー: <span class="font-extrabold text-ink">約{nutrition.kcal}kcal</span>（{style}の目安値。実際の店舗・トッピングにより変動します）
		</p>

		<div
			class="mt-3 flex h-3 overflow-hidden rounded-full bg-surface-sunken"
			role="img"
			aria-label={`PFCバランスの目安：タンパク質${nutrition.protein}g、脂質${nutrition.fat}g、炭水化物${nutrition.carbs}g`}
		>
			<span class="h-full bg-brand-500" style={`width: ${proteinPct}%`} />
			<span class="h-full bg-accent-500" style={`width: ${fatPct}%`} />
			<span class="h-full bg-soy-700" style={`width: ${carbsPct}%`} />
		</div>
		<div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-ink-muted">
			<span class="inline-flex items-center gap-1">
				<span class="inline-block size-2 rounded-full bg-brand-500"></span>タンパク質 {nutrition.protein}g
			</span>
			<span class="inline-flex items-center gap-1">
				<span class="inline-block size-2 rounded-full bg-accent-500"></span>脂質 {nutrition.fat}g
			</span>
			<span class="inline-flex items-center gap-1">
				<span class="inline-block size-2 rounded-full bg-soy-700"></span>炭水化物 {nutrition.carbs}g
			</span>
		</div>

		<p class="mt-3.5 text-sm font-medium text-ink">
			これを消費するには…　🏋️ スクワット約{squatHours.toFixed(1)}時間　/　🏃 ランニング約{runningKm.toFixed(1)}km
		</p>
		<p class="mt-1 text-xs text-ink-faint">※ あくまでユーモアを交えた目安です。運動の効果には個人差があります。</p>
	</div>
</section>
