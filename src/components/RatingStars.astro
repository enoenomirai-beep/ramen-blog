---
interface Props {
	/** 1〜5 の評価 */
	rating: number;
	/** アイコンサイズ（Tailwind の size-* クラス） */
	size?: 'sm' | 'md';
}

const { rating, size = 'sm' } = Astro.props;
const stars = [1, 2, 3, 4, 5];
const iconClass = size === 'md' ? 'size-5' : 'size-4';
---

<span
	class="inline-flex items-center gap-0.5"
	role="img"
	aria-label={`5段階評価: ${rating}`}
	title={`${rating} / 5`}
>
	{
		stars.map((n) => (
			<svg
				class:list={[iconClass, n <= rating ? 'text-amber-400' : 'text-stone-300 dark:text-stone-600']}
				viewBox="0 0 20 20"
				fill="currentColor"
				aria-hidden="true"
			>
				<path d="M10 1.5l2.6 5.4 5.9.8-4.3 4.1 1.1 5.9L10 14.9l-5.3 2.8 1.1-5.9L1.5 7.7l5.9-.8L10 1.5z" />
			</svg>
		))
	}
	<span class="ml-1 text-sm font-semibold tabular-nums text-stone-700 dark:text-stone-300">{rating}.0</span>
</span>
