---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContributionCalendar from '../components/ContributionCalendar.astro';
import Pagination from '../components/Pagination.astro';
import PickupPosts from '../components/PickupPosts.astro';
import PostListItem from '../components/PostListItem.astro';
import PostFilters from '../components/PostFilters.astro';
import { PAGE_SIZE, SITE_DESCRIPTION, withBase } from '../consts';
import { getPublishedPosts } from '../lib/posts';

// 下書きを除き、日付の新しい順（トップページは 1 ページ目、2 ページ目以降は /page/[page]/）
const allPosts = await getPublishedPosts();
const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
const posts = allPosts.slice(0, PAGE_SIZE);

// 系統・場所ごとの記事数（出現順を保つため Map）
function countBy(key: 'style' | 'location') {
	const map = new Map<string, number>();
	for (const post of posts) {
		const value = post.data[key];
		map.set(value, (map.get(value) ?? 0) + 1);
	}
	return map;
}
const styles = countBy('style');
const locations = countBy('location');

// 今日の一杯ガチャ用: 公開済み記事の URL 一覧（base 込み、ページ分割に関係なく全記事から選ぶ）
const gachaUrls = allPosts.map((post) => withBase(`/posts/${post.id}/`));
---

<BaseLayout>
	<section class="mb-6 sm:mb-8">
		<p class="mb-1 text-xs font-bold tracking-widest text-brand-fg uppercase">Ramen Review Log</p>
		<h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">最新のレビュー</h1>
		<p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-muted sm:text-base">
			{SITE_DESCRIPTION}
		</p>
	</section>

	{
		gachaUrls.length > 0 && (
			<section
				class="mb-6 flex flex-col items-center gap-2 rounded-xl border border-line-strong bg-surface-raised p-5 text-center shadow-sm sm:mb-8"
				data-gacha
				data-gacha-urls={JSON.stringify(gachaUrls)}
			>
				<p class="text-sm font-bold text-ink-faint">今日は何を食べる？</p>
				<button
					type="button"
					data-gacha-button
					class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-6 py-3 text-base font-extrabold text-white shadow transition hover:-translate-y-0.5 hover:bg-brand-700"
				>
					🎲 今日の一杯ガチャを回す
				</button>
			</section>
		)
	}

	<PickupPosts />

	<ContributionCalendar />

	<section class="mb-5 rounded-xl border border-line bg-surface-raised p-4 shadow-sm sm:p-5">
		<PostFilters styles={styles} locations={locations} total={posts.length} />
	</section>

	<section aria-label="記事一覧">
		<ol class="flex flex-col gap-4" data-post-list>
			{
				posts.map((post) => (
					<li
						data-post
						data-post-style={post.data.style}
						data-post-location={post.data.location}
						data-post-rating={post.data.rating}
						data-post-date={post.data.date.toISOString()}
					>
						<PostListItem post={post} />
					</li>
				))
			}
		</ol>

		<p
			data-empty-state
			hidden
			class="rounded-xl border border-dashed border-line-strong bg-surface-raised px-6 py-12 text-center text-sm text-ink-muted"
		>
			条件に合う記事はありません。
		</p>
	</section>

	<Pagination currentPage={1} totalPages={totalPages} />
</BaseLayout>

<script>
	// 今日の一杯ガチャ: 公開済み記事からランダムに 1 件選んで移動する
	document.querySelectorAll<HTMLElement>('[data-gacha]').forEach((root) => {
		const button = root.querySelector<HTMLButtonElement>('[data-gacha-button]');
		const urls = JSON.parse(root.dataset.gachaUrls ?? '[]') as string[];
		if (!button || urls.length === 0) return;

		button.addEventListener('click', () => {
			const url = urls[Math.floor(Math.random() * urls.length)];
			location.href = url;
		});
	});
</script>
