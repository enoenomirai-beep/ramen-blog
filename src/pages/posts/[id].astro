---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdBanner from '../../components/AdBanner.astro';
import AffiliateCard from '../../components/AffiliateCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CalorieMeter from '../../components/CalorieMeter.astro';
import Comments from '../../components/Comments.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import FavoriteButton from '../../components/FavoriteButton.astro';
import ShareButtons from '../../components/ShareButtons.astro';
import ShopDetailsModal from '../../components/ShopDetailsModal.astro';
import StarRating from '../../components/StarRating.astro';
import PostNav from '../../components/PostNav.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { SITE_TITLE, formatDate, withBase } from '../../consts';
import { PLACEHOLDER_ALT, placeholderImage } from '../../lib/placeholder';
import { getPublishedPosts, locationPath, stylePath, tagPath, type Post } from '../../lib/posts';
import { estimateReadingMinutes } from '../../lib/reading-time';
import { formatBusinessHours } from '../../lib/business-hours';
import { getShopInfo } from '../../data/shops';

export async function getStaticPaths() {
	// 新しい順（一覧と同じ）。前後ナビ用に隣の記事も props で渡す
	const posts = await getPublishedPosts();
	return posts.map((post, i) => ({
		params: { id: post.id },
		// next = ひとつ新しい記事、prev = ひとつ古い記事（端では undefined）
		props: { post, next: posts[i - 1], prev: posts[i + 1] },
	}));
}

interface Props {
	post: Post;
	prev?: Post;
	next?: Post;
}

const { post, prev, next } = Astro.props;
const {
	title,
	date,
	shop_name,
	style,
	location,
	rating,
	description,
	menu,
	price,
	tags,
	image,
	image_alt,
	map_url,
	business_hours,
	nearest_station,
	visits,
	features,
	lat,
	lng,
	takumen_url,
	amazon_url,
} = post.data;
const { Content, headings } = await render(post);
const readingMinutes = estimateReadingMinutes(post.body ?? '');

// 店舗情報の表。mapHref がある行は値の横に「地図を見る」リンクを添える（場所の行で使う）
const meta: { label: string; value: string; href?: string; mapHref?: string }[] = [
	{ label: '店名', value: shop_name },
	{ label: '系統', value: style, href: withBase(stylePath(style)) },
	{ label: '場所', value: location, href: withBase(locationPath(location)), mapHref: map_url },
];
if (nearest_station) {
	const nearestStations = Array.isArray(nearest_station) ? nearest_station : [nearest_station];
	meta.push({ label: '最寄り駅', value: nearestStations.join('・') });
}
if (business_hours) meta.push({ label: '営業時間', value: formatBusinessHours(business_hours) });
meta.push({ label: '訪問日', value: formatDate(date) });
if (menu) meta.push({ label: '注文', value: menu });
if (price !== undefined) meta.push({ label: '価格', value: `¥${price.toLocaleString('ja-JP')}` });

const shopInfo = getShopInfo(post.id);
// 記事に正確な緯度経度があれば、現在地からの Google マップ経路検索リンクを作る（外部 URL なので withBase() は通さない）
const directionsHref =
	lat !== undefined && lng !== undefined ? `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}` : undefined;

// フロントマターに takumen_url / amazon_url があれば、記事末尾に AffiliateCard を自動表示する
// （画像は無いので imageUrl は渡さない＝AffiliateCard 側で画像無しの1カラムレイアウトになる）
const affiliateLinks = [
	takumen_url && {
		url: takumen_url,
		title: '宅麺.comでお取り寄せ',
		description: `「${shop_name}」が気に入ったら、通販でお取り寄せできるか探してみませんか？`,
		buttonText: '宅麺.comでこの味をお取り寄せ',
	},
	amazon_url && {
		url: amazon_url,
		title: 'Amazonで探す',
		description: `「${shop_name}」に近い味を自宅でも楽しみたい方は、Amazonで探してみてください。`,
		buttonText: 'Amazonで関連商品を見る',
	},
].filter((link): link is { url: string; title: string; description: string; buttonText: string } => Boolean(link));

const homeHref = withBase('/');
const styleHref = withBase(stylePath(style));
const locationHref = withBase(locationPath(location));
// 店名・評価・系統を重ねた動的 OGP 画像（src/pages/og/[slug].png.ts）
const ogImageUrl = withBase(`/og/${post.id}.png`);

// 検索結果にレビューの評価（★）を出すための構造化データ（Google 推奨の Review + Restaurant）
const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Review',
	name: title,
	reviewBody: description,
	itemReviewed: {
		'@type': 'Restaurant',
		name: shop_name,
	},
	reviewRating: {
		'@type': 'Rating',
		ratingValue: rating,
		bestRating: 5,
		worstRating: 1,
	},
	author: {
		'@type': 'Organization',
		name: SITE_TITLE,
	},
	datePublished: date.toISOString(),
};
---

<BaseLayout title={title} description={description} ogImageUrl={ogImageUrl} type="article" structuredData={structuredData}>
	<Breadcrumbs post={post} />

	<article class="mx-auto max-w-3xl">
		<header class="mb-8">
			<!-- 系統・場所のバッジ + タグ -->
			<div class="mb-3 flex flex-wrap items-center gap-1.5 text-xs">
				<a
					href={styleHref}
					class="inline-flex items-center rounded-full bg-chip-brand px-2.5 py-0.5 font-bold text-chip-brand-fg hover:bg-brand-600 hover:text-white"
				>
					{style}
				</a>
				<a
					href={locationHref}
					class="inline-flex items-center gap-1 rounded-full bg-chip px-2.5 py-0.5 font-medium text-chip-fg hover:bg-brand-600 hover:text-white"
				>
					<svg class="size-3" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
						<path
							fill-rule="evenodd"
							d="M9.7 17.7a.5.5 0 0 0 .6 0C13.6 15.2 16 12.3 16 8.9A6 6 0 0 0 4 8.9c0 3.4 2.4 6.3 5.7 8.8ZM10 11a2.3 2.3 0 1 0 0-4.6 2.3 2.3 0 0 0 0 4.6Z"
							clip-rule="evenodd"></path>
					</svg>
					{location}
				</a>
				{
					tags.map((tag) => (
						<a
							href={withBase(tagPath(tag))}
							class="rounded-full border border-line px-2.5 py-0.5 text-ink-muted hover:border-brand-400 hover:text-brand-fg"
						>
							#{tag}
						</a>
					))
				}
				{
					features.map((feature) => (
						<span class="inline-flex items-center rounded-full bg-chip px-2.5 py-0.5 font-medium text-chip-fg">{feature}</span>
					))
				}
			</div>

			<!-- 店名を一番大きく、記事タイトルはその下 -->
			<h1 class="text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl">{shop_name}</h1>
			<p class="mt-2 text-base leading-snug font-medium text-ink-muted sm:text-lg">{title}</p>

			<!-- スコア -->
			<div
				class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-2 rounded-xl border border-line bg-surface-raised px-4 py-3 shadow-sm"
			>
				<StarRating rating={rating} size="lg" />
				{
					visits >= 2 && (
						<span class="inline-flex items-center gap-1 rounded-full bg-chip-brand px-3 py-1 text-sm font-bold text-chip-brand-fg">
							🔥 訪問回数：{visits}回
						</span>
					)
				}
				<div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-ink-muted">
					<span>⏱️ 約{readingMinutes}分で読めます</span>
					<span>
						<span class="mr-1 text-xs font-bold text-ink-faint">訪問日</span>
						<time datetime={date.toISOString()} class="font-medium text-ink">{formatDate(date)}</time>
					</span>
					{
						price !== undefined && (
							<span>
								<span class="mr-1 text-xs font-bold text-ink-faint">お会計</span>
								<span class="font-medium text-ink">¥{price.toLocaleString('ja-JP')}</span>
							</span>
						)
					}
				</div>
			</div>

			<!-- 一杯の写真（無ければイメージ画像） -->
			<figure class="relative mt-6 overflow-hidden rounded-2xl border border-line bg-surface-sunken shadow-sm">
				{
					image ? (
						<Image
							src={image}
							alt={image_alt ?? ''}
							widths={[640, 960, 1200]}
							sizes="(min-width: 768px) 768px, 100vw"
							loading="eager"
							class="aspect-3/2 w-full object-cover"
						/>
					) : (
						<>
							<img
								src={placeholderImage(post.id, 1200, 800)}
								alt={PLACEHOLDER_ALT}
								width="1200"
								height="800"
								loading="eager"
								decoding="async"
								class="aspect-3/2 w-full object-cover"
							/>
							<figcaption class="absolute bottom-3 left-3 rounded bg-black/55 px-2 py-0.5 text-xs font-semibold text-white">
								イメージ画像（実際の一杯とは異なります）
							</figcaption>
						</>
					)
				}
			</figure>

			<!-- 店舗情報 -->
			<section class="mt-6 overflow-hidden rounded-xl border border-line bg-surface-raised shadow-sm" aria-labelledby="shop-info">
				<div class="flex items-center justify-between gap-3 border-b border-line bg-surface-sunken px-4 py-2">
					<h2 id="shop-info" class="text-sm font-bold text-ink">店舗情報</h2>
					{shopInfo && <ShopDetailsModal shop={shopInfo} />}
				</div>
				<dl class="grid grid-cols-1 text-sm sm:grid-cols-2">
					{
						meta.map(({ label, value, href, mapHref }) => (
							<div class="flex gap-3 border-b border-line px-4 py-2.5 last:border-b-0 sm:[&:nth-last-child(2)]:border-b-0">
								<dt class="w-14 shrink-0 text-xs leading-5 font-bold text-ink-faint">{label}</dt>
								<dd class="flex flex-wrap items-center gap-x-3 gap-y-1 font-medium text-ink">
									{href ? <a href={href} class="text-brand-fg hover:underline">{value}</a> : value}
									{mapHref && (
										<a
											href={mapHref}
											target="_blank"
											rel="noopener noreferrer"
											class="inline-flex items-center gap-1 rounded-full border border-line-strong px-2 py-0.5 text-xs font-semibold text-brand-fg hover:border-brand-400 hover:bg-surface-sunken"
										>
											📍 地図を見る
										</a>
									)}
								</dd>
							</div>
						))
					}
				</dl>
				{
					directionsHref && (
						<div class="border-t border-line px-4 py-3">
							<a
								href={directionsHref}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center gap-1.5 rounded-full bg-chip-brand px-3 py-1.5 text-sm font-semibold text-chip-brand-fg hover:bg-brand-600 hover:text-white"
							>
								📍 現在地からの経路を見る
							</a>
						</div>
					)
				}
			</section>
			<CalorieMeter style={style} />
		</header>

		<TableOfContents headings={headings} />

		<AdBanner class="my-6" />

		<div class="article-body prose max-w-none prose-headings:scroll-mt-6">
			<Content />
		</div>

		{affiliateLinks.map((link) => <AffiliateCard {...link} />)}

		<section class="mt-8 flex flex-wrap items-center justify-between gap-3 border-t border-line pt-6">
			<FavoriteButton postId={post.id} />
			<ShareButtons title={shop_name} path={`/posts/${post.id}/`} />
		</section>

		<RelatedPosts currentPost={post} />

		<Comments />

		<footer class="mt-12 border-t border-line pt-6">
			<PostNav prev={prev} next={next} />
			<a href={homeHref} class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-brand-fg hover:underline">
				← 記事一覧に戻る
			</a>
		</footer>

		<AdBanner class="mt-10" />
	</article>
</BaseLayout>
