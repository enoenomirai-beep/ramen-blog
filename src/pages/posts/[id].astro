---
import { Image } from 'astro:assets';
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RatingStars from '../../components/RatingStars.astro';
import PostNav from '../../components/PostNav.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { formatDate, withBase } from '../../consts';
import { getPublishedPosts, stylePath } from '../../lib/posts';

export async function getStaticPaths() {
	// 新しい順（一覧と同じ）。前後ナビ用に隣の記事も props で渡す
	const posts = await getPublishedPosts();
	return posts.map((post, i) => ({
		params: { id: post.id },
		// next = ひとつ新しい記事、prev = ひとつ古い記事（端では undefined）
		props: { post, next: posts[i - 1], prev: posts[i + 1] },
	}));
}

interface Props {
	post: CollectionEntry<'posts'>;
	prev?: CollectionEntry<'posts'>;
	next?: CollectionEntry<'posts'>;
}

const { post, prev, next } = Astro.props;
const { title, date, shop_name, style, location, rating, description, menu, price, tags, image, image_alt } =
	post.data;
const { Content, headings } = await render(post);

const meta: { label: string; value: string }[] = [
	{ label: '店名', value: shop_name },
	{ label: '系統', value: style },
	{ label: '場所', value: location },
	{ label: '訪問日', value: formatDate(date) },
];
if (menu) meta.push({ label: '注文', value: menu });
if (price !== undefined) meta.push({ label: '価格', value: `¥${price.toLocaleString('ja-JP')}` });

const homeHref = withBase('/');
const styleHref = withBase(stylePath(style));
---

<BaseLayout title={title} description={description} ogImage={image} type="article">
	<nav aria-label="パンくずリスト" class="mb-6 text-sm text-stone-500 dark:text-stone-400">
		<a href={homeHref} class="hover:text-orange-600 dark:hover:text-orange-400">記事一覧</a>
		<span aria-hidden="true" class="mx-2">/</span>
		<span class="text-stone-700 dark:text-stone-300">{shop_name}</span>
	</nav>

	<article class="mx-auto max-w-3xl">
		<header class="mb-8">
			<div class="mb-3 flex flex-wrap items-center gap-2">
				<a
					href={styleHref}
					class="inline-flex items-center rounded-full bg-orange-100 dark:bg-orange-950 px-3 py-1 text-xs font-semibold text-orange-800 dark:text-orange-300 hover:bg-orange-200 dark:hover:bg-orange-900"
				>
					{style}
				</a>
				{tags.map((tag) => <span class="rounded-full bg-stone-100 dark:bg-stone-800 px-3 py-1 text-xs text-stone-600 dark:text-stone-400">#{tag}</span>)}
			</div>

			<h1 class="text-2xl leading-tight font-bold tracking-tight sm:text-3xl">{title}</h1>

			<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-stone-600 dark:text-stone-400">
				<RatingStars rating={rating} size="md" />
				<time datetime={date.toISOString()}>{formatDate(date)}</time>
			</div>

			{
				image && (
					<figure class="mt-6 overflow-hidden rounded-2xl border border-stone-200 dark:border-stone-800 bg-stone-100 dark:bg-stone-800">
						<Image
							src={image}
							alt={image_alt ?? ''}
							widths={[640, 960, 1200]}
							sizes="(min-width: 768px) 768px, 100vw"
							loading="eager"
							class="aspect-3/2 w-full object-cover"
						/>
					</figure>
				)
			}

			<dl
				class="mt-6 grid grid-cols-1 gap-x-6 gap-y-3 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-5 text-sm sm:grid-cols-2"
			>
				{
					meta.map(({ label, value }) => (
						<div class="flex gap-3">
							<dt class="w-14 shrink-0 font-semibold text-stone-500 dark:text-stone-400">{label}</dt>
							<dd class="text-stone-800 dark:text-stone-200">{value}</dd>
						</div>
					))
				}
			</dl>
		</header>

		<TableOfContents headings={headings} />

		<div
			class="prose prose-stone dark:prose-invert max-w-none prose-headings:scroll-mt-6 prose-headings:font-bold prose-h2:mt-10 prose-h2:border-l-4 prose-h2:border-orange-500 prose-h2:pl-3 prose-a:text-orange-700 dark:prose-a:text-orange-400 prose-blockquote:text-stone-500 dark:prose-blockquote:text-stone-400 prose-th:bg-stone-100 dark:prose-th:bg-stone-800 prose-th:px-3 prose-th:py-2 prose-td:px-3 prose-td:py-2"
		>
			<Content />
		</div>

		<footer class="mt-12 border-t border-stone-200 dark:border-stone-800 pt-6">
			<PostNav prev={prev} next={next} />
			<a href={homeHref} class="mt-6 inline-flex items-center gap-1 text-sm font-medium text-orange-700 dark:text-orange-400 hover:underline">
				← 記事一覧に戻る
			</a>
		</footer>
	</article>
</BaseLayout>
