---
import { Image } from 'astro:assets';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RatingStars from '../../components/RatingStars.astro';
import { formatDate, withBase } from '../../consts';

export async function getStaticPaths() {
	const posts = await getCollection('posts', ({ data }) => !data.draft);
	return posts.map((post) => ({
		params: { id: post.id },
		props: { post },
	}));
}

interface Props {
	post: CollectionEntry<'posts'>;
}

const { post } = Astro.props;
const { title, date, shop_name, style, location, rating, description, menu, price, tags, image, image_alt } =
	post.data;
const { Content } = await render(post);

const meta: { label: string; value: string }[] = [
	{ label: '店名', value: shop_name },
	{ label: '系統', value: style },
	{ label: '場所', value: location },
	{ label: '訪問日', value: formatDate(date) },
];
if (menu) meta.push({ label: '注文', value: menu });
if (price !== undefined) meta.push({ label: '価格', value: `¥${price.toLocaleString('ja-JP')}` });

const homeHref = withBase('/');
const styleHref = withBase(`/?style=${encodeURIComponent(style)}`);
---

<BaseLayout title={title} description={description} ogImage={image} type="article">
	<nav aria-label="パンくずリスト" class="mb-6 text-sm text-stone-500">
		<a href={homeHref} class="hover:text-orange-600">記事一覧</a>
		<span aria-hidden="true" class="mx-2">/</span>
		<span class="text-stone-700">{shop_name}</span>
	</nav>

	<article class="mx-auto max-w-3xl">
		<header class="mb-8">
			<div class="mb-3 flex flex-wrap items-center gap-2">
				<a
					href={styleHref}
					class="inline-flex items-center rounded-full bg-orange-100 px-3 py-1 text-xs font-semibold text-orange-800 hover:bg-orange-200"
				>
					{style}
				</a>
				{tags.map((tag) => <span class="rounded-full bg-stone-100 px-3 py-1 text-xs text-stone-600">#{tag}</span>)}
			</div>

			<h1 class="text-2xl leading-tight font-bold tracking-tight sm:text-3xl">{title}</h1>

			<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-stone-600">
				<RatingStars rating={rating} size="md" />
				<time datetime={date.toISOString()}>{formatDate(date)}</time>
			</div>

			{
				image && (
					<figure class="mt-6 overflow-hidden rounded-2xl border border-stone-200 bg-stone-100">
						<Image
							src={image}
							alt={image_alt ?? ''}
							widths={[640, 960, 1200]}
							sizes="(min-width: 768px) 768px, 100vw"
							loading="eager"
							class="aspect-3/2 w-full object-cover"
						/>
					</figure>
				)
			}

			<dl
				class="mt-6 grid grid-cols-1 gap-x-6 gap-y-3 rounded-2xl border border-stone-200 bg-white p-5 text-sm sm:grid-cols-2"
			>
				{
					meta.map(({ label, value }) => (
						<div class="flex gap-3">
							<dt class="w-14 shrink-0 font-semibold text-stone-500">{label}</dt>
							<dd class="text-stone-800">{value}</dd>
						</div>
					))
				}
			</dl>
		</header>

		<div
			class="prose prose-stone max-w-none prose-headings:font-bold prose-h2:mt-10 prose-h2:border-l-4 prose-h2:border-orange-500 prose-h2:pl-3 prose-a:text-orange-700 prose-blockquote:text-stone-500 prose-th:bg-stone-100 prose-th:px-3 prose-th:py-2 prose-td:px-3 prose-td:py-2"
		>
			<Content />
		</div>

		<footer class="mt-12 border-t border-stone-200 pt-6">
			<a href={homeHref} class="inline-flex items-center gap-1 text-sm font-medium text-orange-700 hover:underline">
				← 記事一覧に戻る
			</a>
		</footer>
	</article>
</BaseLayout>
