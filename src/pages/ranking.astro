---
/**
 * マイベスト・ランキング。全記事を評価（rating）の降順で並べる。
 * 1〜3 位は王冠・メダルのアイコンで目立たせる。
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import StarRating from '../components/StarRating.astro';
import { formatDate, withBase } from '../consts';
import { PLACEHOLDER_ALT, placeholderImage } from '../lib/placeholder';
import { getPublishedPosts } from '../lib/posts';

const posts = [...(await getPublishedPosts())].sort(
	(a, b) => b.data.rating - a.data.rating || b.data.date.valueOf() - a.data.date.valueOf(),
);

const rankIcons: Record<number, string> = { 1: '👑', 2: '🥈', 3: '🥉' };
const homeHref = withBase('/');
---

<BaseLayout title="マイベスト・ランキング" description="評価（★）が高い順に並べた、管理人のマイベストランキング。">
	<nav aria-label="パンくずリスト" class="mb-5 text-xs text-ink-muted sm:text-sm">
		<a href={homeHref} class="hover:text-brand-fg">記事一覧</a>
		<span aria-hidden="true" class="mx-2 text-ink-faint">/</span>
		<span class="font-medium text-ink">マイベスト・ランキング</span>
	</nav>

	<section class="mb-6 sm:mb-8">
		<p class="mb-1 text-xs font-bold tracking-widest text-brand-fg uppercase">Ranking</p>
		<h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">マイベスト・ランキング</h1>
		<p class="mt-2 text-sm leading-relaxed text-ink-muted sm:text-base">評価（★）が高い順のランキングです。</p>
	</section>

	<ol class="flex flex-col gap-3 sm:gap-4">
		{
			posts.map((post, i) => {
				const rank = i + 1;
				const icon = rankIcons[rank];
				return (
					<li>
						<a
							href={withBase(`/posts/${post.id}/`)}
							class:list={[
								'group flex items-center gap-3 rounded-xl border p-3 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md sm:gap-4 sm:p-4',
								icon
									? 'border-brand-300 bg-chip-brand hover:border-brand-400'
									: 'border-line bg-surface-raised hover:border-brand-300',
							]}
						>
							<div class="flex w-10 shrink-0 flex-col items-center sm:w-12">
								{icon ? (
									<span class="text-2xl sm:text-3xl" aria-hidden="true">
										{icon}
									</span>
								) : (
									<span class="text-lg font-extrabold text-ink-faint tabular-nums sm:text-xl">{rank}</span>
								)}
								<span class="text-[10px] font-bold text-ink-faint">{rank}位</span>
							</div>

							<div class="relative aspect-square w-16 shrink-0 overflow-hidden rounded-lg bg-surface-sunken sm:w-20">
								{post.data.image ? (
									<Image
										src={post.data.image}
										alt=""
										widths={[160, 240]}
										sizes="80px"
										loading="lazy"
										class="h-full w-full object-cover"
									/>
								) : (
									<img
										src={placeholderImage(post.id, 240, 240)}
										alt={PLACEHOLDER_ALT}
										width="240"
										height="240"
										loading="lazy"
										decoding="async"
										class="h-full w-full object-cover"
									/>
								)}
							</div>

							<div class="flex min-w-0 flex-1 flex-col gap-1">
								<p class="text-xs font-bold text-ink-faint">
									{post.data.style} ・ {post.data.location}
								</p>
								<p class="truncate text-base font-extrabold text-ink group-hover:text-brand-fg sm:text-lg">
									{post.data.shop_name}
								</p>
								<StarRating rating={post.data.rating} size="sm" />
							</div>

							<time datetime={post.data.date.toISOString()} class="hidden shrink-0 text-xs text-ink-faint sm:block">
								{formatDate(post.data.date)}
							</time>
						</a>
					</li>
				);
			})
		}
	</ol>
</BaseLayout>
