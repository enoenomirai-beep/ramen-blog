---
/**
 * トップページの 2 ページ目以降（/page/2/ 、/page/3/ ...）。1 ページ目は index.astro（`/`）。
 * ガチャ・殿堂入りピックアップ・ラーメン草カレンダーは 1 ページ目だけの表示なので、ここには置かない。
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pagination from '../../components/Pagination.astro';
import PostListItem from '../../components/PostListItem.astro';
import PostFilters from '../../components/PostFilters.astro';
import { PAGE_SIZE } from '../../consts';
import { getPublishedPosts } from '../../lib/posts';

export async function getStaticPaths() {
	const allPosts = await getPublishedPosts();
	const totalPages = Math.max(1, Math.ceil(allPosts.length / PAGE_SIZE));
	// 2 ページ目以降だけ生成する（1 ページ目は index.astro が `/` で担当）
	return Array.from({ length: totalPages - 1 }, (_, i) => {
		const page = i + 2;
		return {
			params: { page: String(page) },
			props: {
				posts: allPosts.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE),
				currentPage: page,
				totalPages,
			},
		};
	});
}

interface Props {
	posts: Awaited<ReturnType<typeof getPublishedPosts>>;
	currentPage: number;
	totalPages: number;
}

const { posts, currentPage, totalPages } = Astro.props;

// 系統・場所ごとの記事数（このページに表示している記事の中での数。出現順を保つため Map）
function countBy(key: 'style' | 'location') {
	const map = new Map<string, number>();
	for (const post of posts) {
		const value = post.data[key];
		map.set(value, (map.get(value) ?? 0) + 1);
	}
	return map;
}
const styles = countBy('style');
const locations = countBy('location');
---

<BaseLayout title={`記事一覧 ${currentPage} ページ目`}>
	<section class="mb-6 sm:mb-8">
		<p class="mb-1 text-xs font-bold tracking-widest text-brand-fg uppercase">Ramen Review Log</p>
		<h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">最新のレビュー（{currentPage} ページ目）</h1>
	</section>

	<section class="mb-5 rounded-xl border border-line bg-surface-raised p-4 shadow-sm sm:p-5">
		<PostFilters styles={styles} locations={locations} total={posts.length} />
	</section>

	<section aria-label="記事一覧">
		<ol class="flex flex-col gap-4" data-post-list>
			{
				posts.map((post) => (
					<li
						data-post
						data-post-style={post.data.style}
						data-post-location={post.data.location}
						data-post-rating={post.data.rating}
						data-post-date={post.data.date.toISOString()}
					>
						<PostListItem post={post} />
					</li>
				))
			}
		</ol>

		<p
			data-empty-state
			hidden
			class="rounded-xl border border-dashed border-line-strong bg-surface-raised px-6 py-12 text-center text-sm text-ink-muted"
		>
			条件に合う記事はありません。
		</p>
	</section>

	<Pagination currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
