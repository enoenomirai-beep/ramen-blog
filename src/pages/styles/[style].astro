---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';
import { withBase } from '../../consts';
import { getPublishedPosts, groupByStyle, stylePath, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const byStyle = groupByStyle(await getPublishedPosts());
	// 他の系統へのリンク用に、全系統と記事数も各ページに渡す
	const styles = [...byStyle.entries()].map(([style, posts]) => ({ style, count: posts.length }));
	return [...byStyle.entries()].map(([style, posts]) => ({
		params: { style },
		props: { posts, styles },
	}));
}

interface Props {
	/** この系統の記事（新しい順） */
	posts: Post[];
	/** 全系統と記事数 */
	styles: { style: string; count: number }[];
}

const { style } = Astro.params;
const { posts, styles } = Astro.props;
const otherStyles = styles.filter((s) => s.style !== style);

const title = `${style}のラーメン`;
const description = `${style}のラーメンレビュー ${posts.length} 件。店舗・場所・評価つきで記録しています。`;
const homeHref = withBase('/');
const stylesHref = withBase('/styles/');
---

<BaseLayout title={title} description={description}>
	<nav aria-label="パンくずリスト" class="mb-5 text-xs text-ink-muted sm:text-sm">
		<a href={homeHref} class="hover:text-brand-fg">記事一覧</a>
		<span aria-hidden="true" class="mx-2 text-ink-faint">/</span>
		<a href={stylesHref} class="hover:text-brand-fg">系統別</a>
		<span aria-hidden="true" class="mx-2 text-ink-faint">/</span>
		<span class="font-medium text-ink">{style}</span>
	</nav>

	<section class="mb-6 sm:mb-8">
		<p class="mb-1 text-xs font-bold tracking-widest text-brand-fg uppercase">Style</p>
		<h1 class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-2xl font-extrabold tracking-tight sm:text-3xl">
			<span class="inline-flex items-baseline gap-x-1.5">
				<span class="inline-flex items-center rounded-full bg-chip-brand px-3 py-1 text-base font-bold text-chip-brand-fg sm:text-lg">
					{style}
				</span>
				<span>のラーメン</span>
			</span>
			<span class="text-base font-semibold text-ink-muted sm:text-lg">{posts.length} 件</span>
		</h1>

		{
			otherStyles.length > 0 && (
				<div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
					<span class="text-ink-muted">他の系統:</span>
					{otherStyles.map(({ style: other, count }) => (
						<a
							href={withBase(stylePath(other))}
							class="inline-flex items-center gap-1.5 rounded-full border border-line-strong bg-surface-raised px-3 py-1 font-semibold text-ink-muted hover:border-brand-400 hover:text-brand-fg"
						>
							{other}
							<span class="rounded-full bg-surface-sunken px-1.5 text-xs tabular-nums text-ink-muted">{count}</span>
						</a>
					))}
				</div>
			)
		}
	</section>

	<section aria-label={`${style}の記事一覧`}>
		<ol class="flex flex-col gap-4">
			{
				posts.map((post) => (
					<li>
						<PostListItem post={post} />
					</li>
				))
			}
		</ol>
	</section>
</BaseLayout>
