---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TermPosts from '../../components/TermPosts.astro';
import { getPublishedPosts, groupByStyle, stylePath, type Post } from '../../lib/posts';

export async function getStaticPaths() {
	const byStyle = groupByStyle(await getPublishedPosts());
	// 他の系統へのリンク用に、全系統と記事数も各ページに渡す
	const styles = [...byStyle.entries()].map(([style, posts]) => ({ style, count: posts.length }));
	return [...byStyle.entries()].map(([style, posts]) => ({
		params: { style },
		props: { posts, styles },
	}));
}

interface Props {
	/** この系統の記事（新しい順） */
	posts: Post[];
	/** 全系統と記事数 */
	styles: { style: string; count: number }[];
}

const { style } = Astro.params;
const { posts, styles } = Astro.props;
const others = styles
	.filter((s) => s.style !== style)
	.map((s) => ({ name: s.style, href: stylePath(s.style), count: s.count }));

const title = `${style}のラーメン`;
const description = `${style}のラーメンレビュー ${posts.length} 件。店舗・場所・評価つきで記録しています。`;
---

<BaseLayout title={title} description={description}>
	<TermPosts
		kind={{ label: '系統別', href: '/styles/', eyebrow: 'Style' }}
		name={style}
		suffix="のラーメン"
		badge="brand"
		posts={posts}
		others={others}
		othersLabel="他の系統:"
	/>
</BaseLayout>
