---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TermCard from '../../components/TermCard.astro';
import { withBase } from '../../consts';
import { getPublishedPosts, groupByStyle, stylePath } from '../../lib/posts';

// 系統ごとの記事数と最新記事。記事数の多い順（同数なら最新記事が新しい順 = 出現順）
const groups = [...groupByStyle(await getPublishedPosts()).entries()]
	.map(([style, posts]) => ({ style, count: posts.length, latest: posts[0] }))
	.sort((a, b) => b.count - a.count);

const homeHref = withBase('/');
---

<BaseLayout title="系統別" description="ラーメンの系統（家系・二郎系など）ごとのレビュー一覧。">
	<nav aria-label="パンくずリスト" class="mb-5 text-xs text-ink-muted sm:text-sm">
		<a href={homeHref} class="hover:text-brand-fg">記事一覧</a>
		<span aria-hidden="true" class="mx-2 text-ink-faint">/</span>
		<span class="font-medium text-ink">系統別</span>
	</nav>

	<section class="mb-6 sm:mb-8">
		<p class="mb-1 text-xs font-bold tracking-widest text-brand-fg uppercase">Styles</p>
		<h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">系統別</h1>
		<p class="mt-2 text-sm leading-relaxed text-ink-muted sm:text-base">ラーメンの系統ごとにレビューをまとめています。</p>
	</section>

	<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{
			groups.map(({ style, count, latest }) => (
				<li>
					<TermCard name={style} href={stylePath(style)} count={count} latest={latest} />
				</li>
			))
		}
	</ul>
</BaseLayout>
