---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, withBase } from '../../consts';
import { getPublishedPosts, groupByStyle, stylePath } from '../../lib/posts';

// 系統ごとの記事数と最新記事。記事数の多い順（同数なら最新記事が新しい順 = 出現順）
const groups = [...groupByStyle(await getPublishedPosts()).entries()]
	.map(([style, posts]) => ({ style, count: posts.length, latest: posts[0] }))
	.sort((a, b) => b.count - a.count);

const homeHref = withBase('/');
---

<BaseLayout title="系統別" description="ラーメンの系統（家系・二郎系など）ごとのレビュー一覧。">
	<nav aria-label="パンくずリスト" class="mb-6 text-sm text-stone-500 dark:text-stone-400">
		<a href={homeHref} class="hover:text-orange-600 dark:hover:text-orange-400">記事一覧</a>
		<span aria-hidden="true" class="mx-2">/</span>
		<span class="text-stone-700 dark:text-stone-300">系統別</span>
	</nav>

	<section class="mb-8 sm:mb-10">
		<h1 class="text-2xl font-bold tracking-tight sm:text-3xl">系統別</h1>
		<p class="mt-2 text-sm leading-relaxed text-stone-600 dark:text-stone-400 sm:text-base">
			ラーメンの系統ごとにレビューをまとめています。
		</p>
	</section>

	<ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
		{
			groups.map(({ style, count, latest }) => (
				<li>
					<a
						href={withBase(stylePath(style))}
						class="group flex h-full flex-col gap-2 rounded-2xl border border-stone-200 dark:border-stone-800 bg-white dark:bg-stone-900 p-5 transition hover:-translate-y-0.5 hover:border-orange-400 hover:shadow-md"
					>
						<div class="flex items-baseline justify-between gap-3">
							<h2 class="text-lg font-bold text-stone-900 dark:text-stone-100 group-hover:text-orange-700 dark:group-hover:text-orange-400">{style}</h2>
							<span class="text-sm tabular-nums text-stone-500 dark:text-stone-400">{count} 件</span>
						</div>
						<p class="text-xs text-stone-500 dark:text-stone-400">最新の記事</p>
						<p class="line-clamp-2 text-sm leading-snug text-stone-700 dark:text-stone-300">{latest.data.title}</p>
						<time datetime={latest.data.date.toISOString()} class="mt-auto pt-1 text-xs text-stone-500 dark:text-stone-400">
							{formatDate(latest.data.date)}
						</time>
					</a>
				</li>
			))
		}
	</ul>
</BaseLayout>
