---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import ogDefault from '../assets/og-default.jpg';
import FloatingCTA from '../components/FloatingCTA.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { SITE_DESCRIPTION, SITE_TITLE, withBase } from '../consts';

interface Props {
	/** <title> に使うページタイトル（サイト名は自動で付与） */
	title?: string;
	description?: string;
	/** OGP 画像（省略時はサイト共通のデフォルト画像） */
	ogImage?: ImageMetadata;
	/** 動的生成した OGP 画像の URL（base 込み・`withBase()` 済み）。指定時は ogImage より優先する */
	ogImageUrl?: string;
	/** og:type */
	type?: 'website' | 'article';
	/** 検索エンジン向けの構造化データ（JSON-LD）。指定したページの <head> にそのまま出力する */
	structuredData?: Record<string, unknown>;
}

const {
	title,
	description = SITE_DESCRIPTION,
	ogImage = ogDefault,
	ogImageUrl,
	type = 'website',
	structuredData,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE_TITLE}` : SITE_TITLE;

// 絶対 URL は astro.config.mjs の site を基準にする（Astro.url.pathname と画像の src は base 込み）
const canonical = new URL(Astro.url.pathname, Astro.site);
const rssUrl = new URL(withBase('/rss.xml'), Astro.site);
const manifestHref = withBase('/manifest.webmanifest');
const appleTouchIconHref = withBase('/pwa/apple-touch-icon.png');
const swUrl = withBase('/sw.js');
const og = await getImage({ src: ogImage, width: 1200, height: 630, format: 'jpg' });
const resolvedOgImageUrl = ogImageUrl ? new URL(ogImageUrl, Astro.site) : new URL(og.src, Astro.site);

// サイト内リンク（base 付き）
const homeHref = withBase('/');
const rssHref = withBase('/rss.xml');
const stylesHref = withBase('/styles/');
const locationsHref = withBase('/locations/');
const tagsHref = withBase('/tags/');
const mapHref = withBase('/map/');
const rankingHref = withBase('/ranking/');
const dashboardHref = withBase('/dashboard/');
const aboutHref = withBase('/about/');

const navLinkClass =
	'rounded px-2 py-1 text-sm font-semibold text-header-ink/85 transition hover:bg-white/10 hover:text-header-ink';
---

<html lang="ja" class="motion-safe:scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			// 描画前にテーマを決めてちらつきを防ぐ。保存された選択が無ければ OS の設定に従う
			(() => {
				let theme = null;
				try {
					theme = localStorage.getItem('theme');
				} catch {}
				if (theme !== 'light' && theme !== 'dark') {
					theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
		<link rel="icon" href={withBase('/favicon.ico')} />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#a52d14" />

		<!-- PWA（ホーム画面に追加してアプリのように使える） -->
		<link rel="manifest" href={manifestHref} />
		<link rel="apple-touch-icon" href={appleTouchIconHref} />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content={SITE_TITLE} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={rssUrl} />

		<!-- OGP -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content={SITE_TITLE} />
		<meta property="og:locale" content="ja_JP" />
		<meta property="og:title" content={title ?? SITE_TITLE} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={resolvedOgImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<!-- Twitter / X カード -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title ?? SITE_TITLE} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={resolvedOgImageUrl} />

		{structuredData && <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />}

		<GoogleAnalytics />
	</head>
	<body class="flex min-h-dvh flex-col bg-surface text-ink antialiased">
		<!-- 暖簾のような深い赤のヘッダー。下端に鶏油色のライン -->
		<header class="border-b-[3px] border-accent-500 bg-header text-header-ink shadow-md">
			<!-- スマホ: 1 行目にロゴとテーマ切り替え、2 行目にナビ。sm 以上: 1 行に並べる -->
			<div
				class="mx-auto flex w-full max-w-6xl flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2.5 sm:flex-nowrap sm:gap-x-4 sm:px-6 sm:py-3 lg:px-8"
			>
				<a
					href={homeHref}
					class="order-1 mr-auto flex items-center gap-2 text-base font-extrabold tracking-tight whitespace-nowrap sm:text-xl"
				>
					<span aria-hidden="true" class="text-2xl drop-shadow-sm">🍜</span>
					<span>{SITE_TITLE}</span>
				</a>
				<nav
					aria-label="メインナビゲーション"
					class="order-3 -mx-2 flex w-full items-center gap-0.5 whitespace-nowrap sm:order-2 sm:mx-0 sm:w-auto"
				>
					<a href={stylesHref} class={navLinkClass}>系統別</a>
					<a href={locationsHref} class={navLinkClass}>エリア別</a>
					<a href={tagsHref} class={navLinkClass}>タグ</a>
					<a href={mapHref} class={navLinkClass}>マップ</a>
					<a href={rankingHref} class={navLinkClass}>ランキング</a>
					<a href={dashboardHref} class={navLinkClass}>出費ダッシュボード</a>
					<a href={aboutHref} class={navLinkClass}>About</a>
					<a href={rssHref} class={navLinkClass} title="RSS フィード">
						<span class="sr-only">RSS フィード</span>
						<svg class="size-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
							<path
								d="M3.75 3a.75.75 0 0 0 0 1.5A11.75 11.75 0 0 1 15.5 16.25a.75.75 0 0 0 1.5 0A13.25 13.25 0 0 0 3.75 3Zm0 4.5a.75.75 0 0 0 0 1.5 7.25 7.25 0 0 1 7.25 7.25.75.75 0 0 0 1.5 0A8.75 8.75 0 0 0 3.75 7.5ZM5 17a2 2 0 1 0 0-4 2 2 0 0 0 0 4Z"
							></path>
						</svg>
					</a>
				</nav>
				<span class="order-2 flex sm:order-3">
					<ThemeToggle />
				</span>
			</div>
		</header>

		<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
			<slot />
		</main>

		<footer class="border-t border-line bg-surface-sunken pb-20 md:pb-0">
			<div
				class="mx-auto flex w-full max-w-6xl flex-col items-center gap-2 px-4 py-6 text-xs text-ink-muted sm:flex-row sm:justify-between sm:px-6 lg:px-8"
			>
				<span>© {new Date().getFullYear()} {SITE_TITLE}</span>
				<nav aria-label="フッターナビゲーション" class="flex flex-wrap items-center justify-center gap-x-4 gap-y-1">
					<a href={homeHref} class="hover:text-brand-fg">記事一覧</a>
					<a href={stylesHref} class="hover:text-brand-fg">系統別</a>
					<a href={locationsHref} class="hover:text-brand-fg">エリア別</a>
					<a href={tagsHref} class="hover:text-brand-fg">タグ</a>
					<a href={mapHref} class="hover:text-brand-fg">マップ</a>
					<a href={rankingHref} class="hover:text-brand-fg">ランキング</a>
					<a href={dashboardHref} class="hover:text-brand-fg">出費ダッシュボード</a>
					<a href={aboutHref} class="hover:text-brand-fg">About</a>
					<a href={rssHref} class="hover:text-brand-fg">RSS</a>
				</nav>
			</div>
		</footer>

		<FloatingCTA />

	<script is:inline define:vars={{ swUrl }}>
		// オフラインでもキャッシュ済みのページを表示できるように Service Worker を登録する
		if ('serviceWorker' in navigator) {
			window.addEventListener('load', () => {
				navigator.serviceWorker.register(swUrl).catch(() => {});
			});
		}
	</script>
	</body>
</html>
