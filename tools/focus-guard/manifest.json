{
  "manifest_version": 3,
  "name": "Focus Guard",
  "version": "0.1.0",
  "description": "指定サイトを時間帯・集中モードでブロックし、解除しにくくする拡張機能",
  "permissions": ["storage", "alarms", "declarativeNetRequest", "tabs"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "options_page": "options.html",
  "action": { "default_title": "Focus Guard", "default_popup": "options.html" },
  "web_accessible_resources": [
    { "resources": ["blocked.html"], "matches": ["<all_urls>"] }
  ]
}
